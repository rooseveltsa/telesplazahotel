{
  "buildCommand": "npm run build",
  "outputDirectory": "public-dist",
  "rewrites": [
    {
      "source": "/sys",
      "destination": "/sys/index.html"
    },
    {
      "source": "/sys/",
      "destination": "/sys/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sys/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
