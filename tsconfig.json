{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM", "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./sys-src/*"
      ]
    }
  },
  "include": [
    "sys-src"
  ]
}